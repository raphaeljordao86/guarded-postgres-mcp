    "test-conn": "node src/test-conn.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "pg": "^8.21.0"
  },
  "engines": {
    "node": ">=22"
  },
