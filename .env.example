# PostgreSQL connection
# Copy to .env and fill in. Prefer a dedicated, least-privilege role (see README).
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=erp
PG_USER=mcp_agent
PG_PASSWORD=<change_me>
# No client encoding setting: node-postgres always talks UTF8 and the server
# converts from the database encoding (LATIN1, WIN1252, ...) on its own.

# Optional timeouts, in milliseconds (0 disables one).
# PG_CONNECT_TIMEOUT_MS=10000
# PG_STATEMENT_TIMEOUT_MS=120000
# PG_LOCK_TIMEOUT_MS=5000
# PostgreSQL 9.6+. Set it to 0 on older servers, which reject it at connection time.
# PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# JSONL audit log, one line per execution. Use an absolute path.
# If unset, auditing is disabled.
GUARD_AUDIT_LOG_PATH=/var/log/guarded-postgres-mcp/audit.jsonl

# Guardrails (enabled by default; set to false only for local debugging)
GUARD_BLOCK_DML_WITHOUT_WHERE=true
GUARD_BLOCK_DROP=true
# Rolls back any call that leaves a sequence behind MAX() of the key it feeds
# (an INSERT with explicit or MAX()+1 keys and no setval, or a setval that is
# too low). See README.
GUARD_BLOCK_MANUAL_PK=true

# A write statement that changes more rows than this is rolled back unless
# i_understand=true. query returns at most GUARD_QUERY_MAX_ROWS rows.
GUARD_MAX_ROWS=1000
GUARD_QUERY_MAX_ROWS=1000

# Optional legacy naming convention for standalone sequences.
# With both set, table <TABLE_PREFIX><base> is fed by sequence
# <SEQUENCE_PREFIX><base> (e.g. tab_invoice -> gen_invoice).
# Leave either one empty to rely only on serial/identity defaults.
GUARD_LEGACY_TABLE_PREFIX=tab_
GUARD_LEGACY_SEQUENCE_PREFIX=gen_

# Optional: load a different env file (e.g. staging) instead of ../.env.
# The server refuses to start if the file does not exist.
# GUARD_ENV_FILE=/path/to/staging.env
